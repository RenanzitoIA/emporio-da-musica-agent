# Required
OPENAI_API_KEY=sk-...

# Optional
OPENAI_MODEL=gpt-5-mini
# Reasoning effort for reasoning models (minimal | low | medium | high)
OPENAI_REASONING_EFFORT=low
# Simulated "today" for the store (the dataset ends in March 2026). Format: YYYY-MM-DDTHH:MM
STORE_NOW=2026-03-23T10:30
# Where conversation history is stored
HISTORY_DB=var/history.sqlite3
